# Keep in sync with docs/06-tech-stack.md. Never commit .env.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
DATABASE_PATH=./data/parksmart.db

# At least 32 random characters each (e.g. `openssl rand -base64 48`).
SESSION_SECRET=
QR_SIGNING_SECRET=

# Dev-only login (seeded users, no password). Ignored unless NODE_ENV is development or test.
# The server refuses to start if this is "true" when NODE_ENV=production.
DEV_LOGIN_ENABLED=true

# SSO: one identity provider (Google Workspace OR Microsoft Entra), required in
# production. Users sign in with an email at ORG_EMAIL_DOMAIN. Register the redirect URI
# {APP_URL}/api/v1/auth/sso/callback/google (or /entra) with the provider.
ORG_EMAIL_DOMAIN=
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_ENTRA_TENANT_ID=
SSO_ENTRA_CLIENT_ID=
SSO_ENTRA_CLIENT_SECRET=

# First run on an empty database: create the org and pilot site (ignored afterwards).
SETUP_ORG_NAME=
SETUP_SITE_NAME=
# Comma-separated: these people become admins the first time they sign in.
INITIAL_ADMIN_EMAILS=

ANTHROPIC_API_KEY=
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# P1
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Error monitoring (optional). Events carry no personal data.
SENTRY_DSN=
# Shown in Sentry as the release (optional), e.g. the git SHA.
APP_VERSION=

# Off-site SQLite backups with Litestream (production image only; optional).
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
DEFAULT_TIMEZONE=Asia/Kolkata
