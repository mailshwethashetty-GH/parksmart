# Keep in sync with docs/06-tech-stack.md. Never commit .env.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
DATABASE_PATH=./data/parksmart.db

# At least 32 random characters each (e.g. `openssl rand -base64 48`).
SESSION_SECRET=
QR_SIGNING_SECRET=

# Dev-only login (seeded users, no password). Ignored unless NODE_ENV is development or test.
# The server refuses to start if this is "true" when NODE_ENV=production.
DEV_LOGIN_ENABLED=true

SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_ENTRA_TENANT_ID=
SSO_ENTRA_CLIENT_ID=
SSO_ENTRA_CLIENT_SECRET=

ANTHROPIC_API_KEY=
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# P1
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

SENTRY_DSN=
DEFAULT_TIMEZONE=Asia/Kolkata
